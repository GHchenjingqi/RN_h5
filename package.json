    "preview": "vite preview"
  },
  "dependencies": {
    "@nutui/nutui-react": "^4.0.0-beta.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^5.0.0"
  }
}
